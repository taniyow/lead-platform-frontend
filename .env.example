# Internal URL of the backend API. Server-side only (no NEXT_PUBLIC_ prefix):
# the browser never talks to the backend directly — Next.js server routes proxy to it.
BACKEND_INTERNAL_URL=http://127.0.0.1:4001

# Production server bind address (server.js). The frontend is the public
# process, so it binds all interfaces by default. PORT is the public port.
HOST=0.0.0.0
PORT=3000
